<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="final_arm_urdf">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import final_arm_urdf urdf file -->
    <xacro:include filename="$(find final_arm_urdf)/urdf/final_arm_urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="final_arm_urdf.ros2_control.xacro" />


    <xacro:final_arm_urdf_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
